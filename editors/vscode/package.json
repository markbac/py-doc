{
  "name": "vscode-py-doc-preview",
  "displayName": "py-doc Markdown Preview",
  "description": "Preview py-doc Markdown in VS Code: numbered captions, Word-style callouts, slide decks, and posters.",
  "version": "1.0.0",
  "publisher": "py-doc",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "py-doc",
    "markdown",
    "preview",
    "docx",
    "pandoc",
    "captions",
    "callouts",
    "posters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pydoc.openLiveWatch",
        "title": "Open Live Preview (HTML Twin Watch Server)",
        "category": "py-doc",
        "icon": "$(eye)"
      },
      {
        "command": "pydoc.openDocxWatch",
        "title": "Open Live Word Document Preview (docx --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.openSlidesWatch",
        "title": "Open Live Presentation Preview (slides --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.openPosterWatch",
        "title": "Open Live Poster Preview (poster --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.stopLiveWatch",
        "title": "Stop Live Preview Server",
        "category": "py-doc"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pydoc.openLiveWatch",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "py-doc",
      "properties": {
        "pydoc.watch.port": {
          "type": "number",
          "default": 8765,
          "description": "The local port the live preview watch server (py-doc ... --watch) serves on."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/py-doc-preview.css"
    ]
  },
  "scripts": {
    "test": "node test/test.js"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0"
  }
}
