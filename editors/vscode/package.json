{
  "name": "vscode-py-doc-preview",
  "displayName": "py-doc Live Preview",
  "description": "Live preview of py-doc documents, slide decks and posters in VS Code: py-doc's own output, rebuilt on every save. Highlights py-doc directives and variables in Markdown, bpmn-text (.bpmnt) files and ```bpmnt fences.",
  "version": "2.2.0",
  "publisher": "py-doc",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/markbac/py-doc.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/markbac/py-doc/issues"
  },
  "homepage": "https://github.com/markbac/py-doc/tree/main/editors/vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "py-doc",
    "markdown",
    "preview",
    "docx",
    "slides",
    "posters",
    "live preview",
    "bpmn"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bpmnt",
        "aliases": [
          "bpmn-text",
          "bpmnt"
        ],
        "extensions": [
          ".bpmnt"
        ],
        "configuration": "./syntaxes/bpmnt.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bpmnt",
        "scopeName": "source.bpmnt",
        "path": "./syntaxes/bpmnt.tmLanguage.json"
      },
      {
        "scopeName": "markdown.bpmnt.codeblock",
        "path": "./syntaxes/bpmnt.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bpmnt": "bpmnt"
        }
      },
      {
        "scopeName": "markdown.pydoc.directives",
        "path": "./syntaxes/pydoc.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ],
    "commands": [
      {
        "command": "pydoc.openLiveWatch",
        "title": "Open Live Preview",
        "category": "py-doc",
        "icon": "$(eye)"
      },
      {
        "command": "pydoc.openDocxWatch",
        "title": "Open Live Word Document Preview (docx --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.openSlidesWatch",
        "title": "Open Live Presentation Preview (slides --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.openPosterWatch",
        "title": "Open Live Poster Preview (poster --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.stopLiveWatch",
        "title": "Stop Live Preview Server",
        "category": "py-doc"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pydoc.openLiveWatch",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "py-doc",
      "properties": {
        "pydoc.watch.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "The local port the live preview serves on. 0 lets py-doc pick a free one, so several windows can each have a preview."
        },
        "pydoc.executable": {
          "type": "string",
          "default": "py-doc",
          "scope": "machine-overridable",
          "description": "The py-doc program the live preview runs, such as the py-doc of a virtual environment (.venv/Scripts/py-doc.exe or .venv/bin/py-doc)."
        },
        "pydoc.watch.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Move a running live preview to another Markdown file when it becomes the active editor."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/detect.test.js test/cases.test.js test/watch.test.js test/grammar.test.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
