{
  "name": "vscode-py-doc-preview",
  "displayName": "py-doc Markdown Preview",
  "description": "Preview py-doc Markdown in VS Code: numbered captions, Word-style callouts, slide decks, and posters.",
  "version": "1.0.0",
  "publisher": "py-doc",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/markbac/py-doc.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/markbac/py-doc/issues"
  },
  "homepage": "https://github.com/markbac/py-doc/tree/main/editors/vscode#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "py-doc",
    "markdown",
    "preview",
    "docx",
    "pandoc",
    "captions",
    "callouts",
    "posters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pydoc.openLiveWatch",
        "title": "Open Live Preview (HTML Twin Watch Server)",
        "category": "py-doc",
        "icon": "$(eye)"
      },
      {
        "command": "pydoc.openDocxWatch",
        "title": "Open Live Word Document Preview (docx --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.openSlidesWatch",
        "title": "Open Live Presentation Preview (slides --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.openPosterWatch",
        "title": "Open Live Poster Preview (poster --watch)",
        "category": "py-doc"
      },
      {
        "command": "pydoc.stopLiveWatch",
        "title": "Stop Live Preview Server",
        "category": "py-doc"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pydoc.openLiveWatch",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "py-doc",
      "properties": {
        "pydoc.watch.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "The local port the live preview serves on. 0 lets py-doc pick a free one, so several windows can each have a preview."
        },
        "pydoc.executable": {
          "type": "string",
          "default": "py-doc",
          "scope": "machine-overridable",
          "description": "The py-doc program the live preview runs, such as the py-doc of a virtual environment (.venv/Scripts/py-doc.exe or .venv/bin/py-doc)."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/py-doc-preview.css"
    ]
  },
  "scripts": {
    "test": "node --test test/test.js test/cases.test.js test/watch.test.js",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "markdown-it": "^14.1.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
