{
  "name": "vscode-py-doc-preview",
  "displayName": "py-doc Markdown Preview",
  "description": "Preview py-doc Markdown in VS Code: numbered captions, Word-style callouts, slide decks, and posters.",
  "version": "1.0.0",
  "publisher": "py-doc",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./extension.js",
  "categories": [
    "Other",
    "Formatters"
  ],
  "keywords": [
    "py-doc",
    "markdown",
    "preview",
    "docx",
    "pandoc",
    "captions",
    "callouts",
    "posters"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pydoc.openPosterWatch",
        "title": "py-doc: Open Live Poster Preview (via Watch Server)",
        "category": "py-doc",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pydoc.openPosterWatch",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./styles/py-doc-preview.css"
    ]
  },
  "scripts": {
    "test": "node test/test.js"
  },
  "devDependencies": {
    "markdown-it": "^14.1.0"
  }
}
