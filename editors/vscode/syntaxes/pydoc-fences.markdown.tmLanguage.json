    "info-attribute": {
      "match": "([A-Za-z_][\\w-]*)(=)(\"[^\"]*\"|'[^']*'|[^\\s}]+)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.pydoc"
        },
        "2": {
          "name": "keyword.operator.assignment.pydoc"
        },
        "3": {
          "name": "string.unquoted.value.pydoc"
        }
      }
    }
