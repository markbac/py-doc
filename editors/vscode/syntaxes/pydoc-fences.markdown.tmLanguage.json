          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.pydoc-plantuml",
          "patterns": [
            {
              "include": "source.pydoc.plantuml"
            }
          ]
        }
      ]
    },
