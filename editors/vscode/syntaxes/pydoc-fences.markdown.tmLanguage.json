    "block-fence": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(gradient\\-scale|standard\\-model|syntax\\-anatomy|energy\\-levels|interferometer|nuclide\\-chart|code\\-compare|thermo\\-cycle|hex\\-dissect|fault\\-tree|gene\\-locus|plc\\-ladder|structogram|uncertainty|zoom\\-chain|instrument|annotated|checklist|highlight|phylogeny|seq\\-logo|spacetime|sun\\-path|threshold|elements|equation|glossary|logscale|molecule|progress|proscons|railroad|segments|spectrum|terminal|timeline|balance|barcode|buckets|circuit|compare|cutaway|feynman|gallery|iceberg|plasmid|pyramid|ternary|vessels|bowtie|dial24|figure|funnel|memory|optics|orbits|people|pikchr|pinout|rating|target|cards|chart|chess|cycle|gauge|idef0|lanes|music|onion|sizes|smith|stack|steps|upset|atom|cone|flow|kmap|plot|ring|tape|abc|cie|gsn|lcd|vsm|n2|qr)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "beginCaptures": {
