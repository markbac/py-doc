{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "py-doc's diagram fences and poster blocks in Markdown, each highlighted with the grammar of its language. Every fence py-doc draws is listed: tests/test_editor_grammar.py checks it against py-doc's own list",
  "scopeName": "markdown.pydoc.fences",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#dot-fence"
    },
    {
      "include": "#mermaid-fence"
    },
    {
      "include": "#plantuml-fence"
    },
    {
      "include": "#json-fence"
    },
    {
      "include": "#javascript-fence"
    },
    {
      "include": "#yaml-fence"
    },
    {
      "include": "#clojure-fence"
    },
    {
      "include": "#block-fence"
    },
    {
      "include": "#plain-fence"
    }
  ],
  "repository": {
    "dot-fence": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(packetdiag|blockdiag|graphviz|rackdiag|actdiag|seqdiag|nwdiag|dot)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        },
        "5": {
          "name": "fenced_code.block.language.attributes.markdown",
          "patterns": [
            {
              "include": "#info-attribute"
            }
          ]
        }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "name": "markup.fenced_code.block.markdown",
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.pydoc-dot",
          "patterns": [
            {
              "include": "source.pydoc.dot"
            }
          ]
        }
      ]
    },
    "mermaid-fence": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(mermaid)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
