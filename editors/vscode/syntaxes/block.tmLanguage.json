{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "The written forms of py-doc's poster blocks, plot, and the circuit, chess, music and science fences: 'a | b | c' rows, key=value options, 'key:' lines, icons, numbers, strings and comments",
  "scopeName": "source.pydoc.block",
  "patterns": [
    { "include": "#comment" },
    { "include": "#key" },
    { "include": "#option" },
    { "include": "#icon" },
    { "include": "#string" },
    { "include": "#colour" },
    { "include": "#number" },
    { "include": "#separator" }
  ],
  "repository": {
    "comment": { "name": "comment.line.number-sign.pydoc", "match": "^\\s*#(?![0-9A-Fa-f]{3,8}\\b).*$" },
    "key": {
      "match": "^\\s*([A-Za-z][\\w -]*?)(:)(?=\\s|$)",
      "captures": {
        "1": { "name": "entity.name.tag.key.pydoc" },
        "2": { "name": "punctuation.separator.key-value.pydoc" }
      }
    },
    "option": {
      "match": "\\b([a-z][\\w-]*)(=)(\"[^\"]*\"|[^\\s|]*)",
      "captures": {
        "1": { "name": "entity.other.attribute-name.pydoc" },
        "2": { "name": "keyword.operator.assignment.pydoc" },
        "3": { "name": "string.unquoted.value.pydoc" }
      }
    },
    "icon": { "name": "support.constant.icon.pydoc", "match": "\\b(tabler|mdi|logos|wi):[\\w-]+" },
    "string": { "name": "string.quoted.double.pydoc", "match": "\"[^\"]*\"" },
    "colour": { "name": "constant.other.color.pydoc", "match": "#[0-9A-Fa-f]{3,8}\\b" },
    "number": { "name": "constant.numeric.pydoc", "match": "(?<![\\w.])[-+]?\\d+([.,]\\d+)?(%|[a-zA-Zµμ°Ω]{0,3})?(?![\\w.])" },
    "separator": { "name": "punctuation.separator.cell.pydoc", "match": "\\|" }
  }
}
