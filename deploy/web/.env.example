# Settings of py-doc web. deploy.sh copies this to .env and fills in the ids the first time.

# Where the workspace, temporary files and caches live on the host. It is mounted at the same path
# inside the container. Use an absolute path.
PYDOC_DATA=/srv/py-doc

# The user and group the server runs as: the owner of PYDOC_DATA. `id -u` and `id -g`.
PUID=1000
PGID=1000

# The group that owns /var/run/docker.sock: `stat -c %g /var/run/docker.sock`
DOCKER_GID=

# The port on the host, and the address to listen on (127.0.0.1 when only a proxy on this host reaches it).
PYDOC_WEB_PORT=8080
PYDOC_WEB_BIND=0.0.0.0

# A password for the page (any user name). Leave it empty only when a proxy such as Nginx Proxy Manager
# asks for one in front of it.
PYDOC_WEB_PASSWORD=

# Jobs that run at the same time, and the seconds one may take.
PYDOC_WEB_WORKERS=1
PYDOC_WEB_TIMEOUT=1800
